const express = require('express');
const mysql = require('mysql2/promise');

/*
    Setup:
    npm init -y
    npm install express ejs mysql2
    Import expense_db.sql first, then: node server.js
*/

const app = express();
const PORT = 3000;

// Middleware
app.use(express.urlencoded({ extended: true }));
app.set('view engine', 'ejs');

// MySQL connection pool
const db = mysql.createPool({
    host: 'localhost',
    user: 'root',
    password: '',
    database: 'expense_db',
    waitForConnections: true,
    connectionLimit: 10
});

// Test database connection on startup
db.getConnection()
    .then(conn => {
        console.log('Connected to MySQL');
        conn.release();
    })
    .catch(err => console.error('Database connection failed:', err.message));

// Convert DECIMAL strings from MySQL into numbers for the views
const normalize = (row) => ({ ...row, amount: parseFloat(row.amount) });

// 1. READ: View all expenses for the week
app.get('/', async (req, res) => {
    try {
        const [rows] = await db.query('SELECT * FROM expenses ORDER BY id DESC');
        const expenses = rows.map(normalize);
        const totalAmount = expenses.reduce((sum, item) => sum + item.amount, 0);
        res.render('index', { expenses, totalAmount });
    } catch (err) {
        console.error(err);
        res.status(500).send('Database error');
    }
});

// 2. CREATE: Render Add Form
app.get('/add', (req, res) => {
    res.render('add');
});

// 2. CREATE: Process Add Form submission
app.post('/add', async (req, res) => {
    try {
        const { title, amount, day, category } = req.body;
        await db.query(
            'INSERT INTO expenses (title, amount, day, category) VALUES (?, ?, ?, ?)',
            [title, parseFloat(amount), day, category]
        );
        res.redirect('/');
    } catch (err) {
        console.error(err);
        res.status(500).send('Database error');
    }
});

// 3. UPDATE: Render Edit Form
app.get('/edit/:id', async (req, res) => {
    try {
        const [rows] = await db.query('SELECT * FROM expenses WHERE id = ?', [req.params.id]);
        if (rows.length === 0) return res.redirect('/');
        res.render('edit', { expense: normalize(rows[0]) });
    } catch (err) {
        console.error(err);
        res.status(500).send('Database error');
    }
});

// 3. UPDATE: Process Edit Form submission
app.post('/edit/:id', async (req, res) => {
    try {
        const { title, amount, day, category } = req.body;
        await db.query(
            'UPDATE expenses SET title = ?, amount = ?, day = ?, category = ? WHERE id = ?',
            [title, parseFloat(amount), day, category, req.params.id]
        );
        res.redirect('/');
    } catch (err) {
        console.error(err);
        res.status(500).send('Database error');
    }
});

// 4. DELETE: Remove Expense
app.post('/delete/:id', async (req, res) => {
    try {
        await db.query('DELETE FROM expenses WHERE id = ?', [req.params.id]);
        res.redirect('/');
    } catch (err) {
        console.error(err);
        res.status(500).send('Database error');
    }
});

app.listen(PORT, () => {
    console.log(`Weekly Expense Tracker running on http://localhost:${PORT}`);
});