<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Weekly Expense Tracker</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 30px; background-color: #F5EBDD; }
        .container { max-width: 800px; margin: 0 auto; background: white; padding: 20px; border-radius: 8px; box-shadow: 0 0 10px rgba(0,0,0,0.1); }
        .header { display: flex; justify-content: space-between; align-items: center; }
        .btn { padding: 8px 12px; text-decoration: none; border-radius: 4px; border: none; cursor: pointer; color: white; }
        .btn-add { background-color: #315B8C; }
        .btn-edit { background-color: #315B8C; color: white; }
        .btn-delete { background-color: #413333; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { border: 1px solid #ddd; padding: 12px; text-align: left; }
        th { background-color: #F2765E; color: white; }
        .total-box { margin-top: 20px; font-size: 18px; font-weight: bold; background: #e9ecef; padding: 10px; border-radius: 4px; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Weekly Expense Tracker</h1>
            <a href="/add" class="btn btn-add">+ New</a>
        </div>

        <div class="total-box">
            Total Spent This Week: ₱<%= totalAmount.toFixed(2) %>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Day</th>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Amount (₱)</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (expenses.length === 0) { %>
                    <tr>
                        <td colspan="5" style="text-align: center;">No expenses recorded for this week.</td>
                    </tr>
                <% } else { %>
                    <% expenses.forEach(expense => { %>
                        <tr>
                            <td><%= expense.day %></td>
                            <td><%= expense.title %></td>
                            <td><%= expense.category %></td>
                            <td>₱<%= parseFloat(expense.amount).toFixed(2) %></td>
                            <td>
                                <a href="/edit/<%= expense.id %>" class="btn btn-edit">Edit</a>
                                <form action="/delete/<%= expense.id %>" method="POST" style="display:inline;">
                                    <button type="submit" class="btn btn-delete" onclick="return confirm('Delete this item?')">Delete</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
    </div>
</body>
</html>